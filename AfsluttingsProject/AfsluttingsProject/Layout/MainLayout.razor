@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row" style="justify-content: flex-start !important">
            <h3>
                Socks: @socksController?.saveData.socks
            </h3>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    [CascadingParameter(Name = "SocksController")]
    private SocksController? socksController { get; set; }

    public static MainLayout? Instance { get; private set; }

    protected override void OnInitialized()
    {
        Instance = this;
    }

    public void forceUpdate()
    {
        StateHasChanged();
    }
}
