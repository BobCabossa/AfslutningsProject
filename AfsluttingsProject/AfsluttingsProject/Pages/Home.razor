@page "/"

<PageTitle>Home</PageTitle>

<Row>
    <Column>
        <Button Class="w-100 btn btn-primary" Clicked="Clicked">
            <Image Class="w-100" Source="Sock clicker\dirtySock.png" Text="A sock..." />
        </Button>
    </Column>
</Row>

@code {
    [CascadingParameter(Name = "SocksController")]
    private SocksController? socksController { get; set; }

    private void Clicked()
    {
        if (socksController == null) return;

        socksController.saveData.socks += 1;
        MainLayout.Instance?.forceUpdate();
    }
}